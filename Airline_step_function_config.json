{
  "Comment": "A description of my state machine",
  "StartAt": "Start_daily_raw_flights_crawler",
  "States": {
    "Start_daily_raw_flights_crawler": {
      "Type": "Task",
      "Arguments": {
        "Name": "daily_raw_flights_crawler"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Next": "GetCrawlerStatus"
    },
    "GetCrawlerStatus": {
      "Type": "Task",
      "Arguments": {
        "Name": "daily_raw_flights_crawler"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Output": {
        "CrawlerState": "{% $states.result.Crawler.State %}"
      },
      "Next": "CheckAndWait"
    },
    "CheckAndWait": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Wait",
          "Condition": "{% $states.input.CrawlerState = 'RUNNING' %}"
        }
      ],
      "Default": "TriggerGlueJob"
    },
    "Wait": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "GetCrawlerStatus"
    },
    "TriggerGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "Airline incremental data processing ETL"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "Next": "GlueJobfailed_Notification"
        }
      ],
      "Next": "GlueJobSuccess_Notification"
    },
    "GlueJobSuccess_Notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "arn:aws:sns:us-east-1:204183190032:Topic-1",
        "Message": {
          "Job": "Airline",
          "Status": "Executed"
        }
      },
      "End": true
    },
    "GlueJobfailed_Notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "arn:aws:sns:us-east-1:204183190032:Topic-1",
        "Message": {
          "Job": "Airline Data processing Glue job",
          "Status": "Failed",
          "Error": "{% $states %}"
        }
      },
      "End": true
    }
  },
  "QueryLanguage": "JSONata"
}